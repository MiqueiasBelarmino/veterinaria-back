generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VET
  CLIENT
  ADMIN
}

enum AppointmentType {
  CONSULTATION
  INITIAL
  RETURN
  HOME_VISIT
  BOARDING
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

enum NutritionProtocol {
  BASIC
  OBESITY
  ENDOCRINE
  CME
  DIABETES
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client    Client? @relation("UserToClient")
  vet       Vet?

  @@map("users")
}

model Vet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  crmv      String?
  specialty String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  prescriptions Prescription[]

  @@map("vets")
}

model Client {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  name      String
  email     String?
  address   String?
  phone     String?
  user      User?    @relation("UserToClient", fields: [userId], references: [id], onDelete: SetNull)
  pets      Pet[]
  sales     Sale[]

  @@map("clients")
}

model Pet {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  name        String
  species     String
  breed       String?
  birthDate   DateTime? @map("birth_date")
  weight      Float?
  sex         String?
  isNeutered  Boolean  @default(false) @map("is_neutered")
  clinicalNotes String? @map("clinical_notes")
  observations String?
  
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  prescriptions Prescription[]
  plans       Plan[]
  clinicalRecords ClinicalRecord[]
  laboratoryExams LaboratoryExam[]
  dietaryPlans    DietaryPlan[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pets")
}

model Appointment {
  id          String            @id @default(uuid())
  petId       String            @map("pet_id")
  date        DateTime
  type        AppointmentType
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  planId      String?           @map("plan_id")
  
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  plan        Plan?    @relation(fields: [planId], references: [id])
  prescription Prescription?
  clinicalRecords ClinicalRecord[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("appointments")
}

model Prescription {
  id            String   @id @default(uuid())
  appointmentId String?  @unique @map("appointment_id")
  petId         String   @map("pet_id")
  vetId         String   @map("vet_id")
  date          DateTime @default(now())
  observations  String?

  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  pet           Pet          @relation(fields: [petId], references: [id])
  vet           Vet          @relation(fields: [vetId], references: [id])
  items         PrescriptionItem[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  medication     String
  dosage         String
  frequency      String?
  duration       String?
  notes          String?

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model ClinicalRecord {
  id            String   @id @default(uuid())
  petId         String   @map("pet_id")
  appointmentId String?  @map("appointment_id")
  planId        String?  @map("plan_id")
  date          DateTime @default(now())
  weight        Float?
  notes         String?
  
  pet           Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  plan          Plan?        @relation(fields: [planId], references: [id])

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("clinical_records")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  category    String?
  
  saleItems   SaleItem[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model Sale {
  id        String   @id @default(uuid())
  clientId  String?  @map("client_id")
  total     Float
  date      DateTime @default(now())
  
  client    Client?  @relation(fields: [clientId], references: [id])
  items     SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id")
  productId String   @map("product_id")
  quantity  Int
  price     Float

  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model PlanDefinition {
  id               String   @id @default(uuid())
  name             String
  type             String
  durationInMonths Int      @map("duration_in_months")
  returnsIncluded  Int      @map("returns_included")
  examReturnCounts Boolean  @default(false) @map("exam_return_counts")
  isActive         Boolean  @default(true) @map("is_active")
  
  plans            Plan[]

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("plan_definitions")
}

enum PlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Plan {
  id                     String   @id @default(uuid())
  petId                  String   @map("pet_id")
  planDefinitionId       String   @map("plan_definition_id")
  startDate              DateTime @map("start_date")
  endDate                DateTime @map("end_date")
  status                 PlanStatus @default(ACTIVE)
  returnsUsed            Int      @default(0) @map("returns_used")
  overrideExamReturnCounts Boolean? @map("override_exam_return_counts")

  pet                    Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  definition             PlanDefinition @relation(fields: [planDefinitionId], references: [id])
  
  appointments           Appointment[]
  clinicalRecords        ClinicalRecord[]
  laboratoryExams        LaboratoryExam[]
  dietaryPlans           DietaryPlan[]

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model LaboratoryExam {
  id          String            @id @default(uuid())
  petId       String            @map("pet_id")
  planId      String?           @map("plan_id")
  protocol    NutritionProtocol
  date        DateTime          @default(now())
  results     String
  attachments String[]          @default([])
  
  pet         Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  plan        Plan?             @relation(fields: [planId], references: [id])

  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("laboratory_exams")
}

model DietaryPlan {
  id              String   @id @default(uuid())
  petId           String   @map("pet_id")
  planId          String?  @map("plan_id")
  version         Int      @default(1)
  isActive        Boolean  @default(true) @map("is_active")
  observations    String?
  startDate       DateTime @default(now()) @map("start_date")
  
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  plan            Plan?    @relation(fields: [planId], references: [id])
  meals           Meal[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dietary_plans")
}

model Meal {
  id              String   @id @default(uuid())
  dietaryPlanId   String   @map("dietary_plan_id")
  name            String
  time            String?
  order           Int      @default(0)
  
  dietaryPlan     DietaryPlan @relation(fields: [dietaryPlanId], references: [id], onDelete: Cascade)
  items           MealItem[]

  @@map("meals")
}

model MealItem {
  id              String   @id @default(uuid())
  mealId          String   @map("meal_id")
  foodName        String   @map("food_name")
  quantity        Float
  unit            String
  frequency       String?
  notes           String?
  substitutions   String?
  combinations    String?
  
  meal            Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("meal_items")
}
